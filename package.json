{
  "name": "@viamedici-spc/configurator-react",
  "version": "0.0.0",
  "description": "React library to build configurator web applications based on the Viamedici Headless Configuration Engine (HCE).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamedici-spc/configurator-react.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "workspaces": [
    "test-app"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "bun check && bun check -p tests",
    "verify:package": "bun run build && publint --strict && attw --pack . --profile esm-only --format table-flipped"
  },
  "keywords": [
    "viamedici",
    "product",
    "configuration",
    "spc",
    "hce",
    "csp",
    "constraint",
    "satisfaction",
    "problem",
    "solver",
    "react"
  ],
  "author": "Viamedici Software GmbH",
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@viamedici-spc/configurator-ts": "5.0.0-modern-toolchain-20261126112243",
    "@viamedici-spc/fp-ts-extensions": "2.0.0-modern-toolchain-20261126094931",
    "dyna-guid": "^2.3.3",
    "fp-ts-react-stable-hooks": "^2.0.0",
    "jotai": "^3",
    "jotai-effect": "^2",
    "jotai-family": "^1.1.0",
    "jotai-xstate": "^0.6",
    "p-defer": "^4.0.1",
    "xstate": "^5.33.4"
  },
  "peerDependencies": {
    "react": "^18.2 || ^19"
  },
  "inlinedDependencies": {
    "memize": "2.1.1",
    "ts-pattern": "5.9.2"
  }
}
