{
  "printWidth": 120,
  "tabWidth": 4,
  "bracketSpacing": false,
  "arrowParens": "avoid",
  "ignorePatterns": ["**/*.md", "dist/**", "test-app/dist/**"],
  "overrides": [
    {
      "files": ["*.json", "*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "endOfLine": "lf"
}