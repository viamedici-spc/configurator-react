{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "react-perf", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  },
  "ignorePatterns": ["dist/**", "package-check/consumer/index.ts", "test-app/dist/**", "test-app/**"],
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "react-hooks/exhaustive-deps": "off",
        "unicorn/no-useless-spread": "off"
      }
    }
  ]
}